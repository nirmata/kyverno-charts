{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "llm": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["bedrock", "azure-openai", "nirmataAI", "anthropic"]
        },
        "bedrock": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": { "type": "string" },
            "region": { "type": "string" },
            "secretRef": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        },
        "azureOpenAI": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "endpoint": { "type": "string" },
            "deploymentName": { "type": "string" },
            "secretRef": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        },
        "nirmataAI": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": { "type": "string" }
          }
        },
        "anthropic": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": { "type": "string" },
            "baseURL": { "type": "string" },
            "secretRef": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "nirmata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpoint": { "type": "string" },
        "auth": {
          "type": "string",
          "description": "Nirmata platform authentication method. Use \"none\" (or leave empty) when no Nirmata platform functionality is required, e.g. when using your own LLM provider and GitHub credentials.",
          "enum": ["serviceAccountToken", "apiToken", "none", ""]
        },
        "serviceAccountTokenSecret": { "type": "string" },
        "serviceAccountTokenSecretKey": { "type": "string" },
        "apiTokenSecret": { "type": "string" },
        "apiTokenSecretKey": { "type": "string" }
      }
    },
    "remediator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "environment": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "description": "Environment type for the Remediator CR. Must stay in sync with the EnvironmentType enum in api/v1alpha1/remediator_types.go.",
              "enum": ["localCluster", "argoHub", "fluxHub"]
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "environment": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "description": "Environment type for the Agent CR. Must stay in sync with the EnvironmentType enum in api/v1alpha1/remediator_types.go. fluxHub is accepted by the CRD but is intentionally omitted here: templates/agent.yaml cannot render an agent.target.fluxHub block, so it would fail CRD validation after install.",
              "enum": ["localCluster", "argoHub"]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": { "const": "bedrock" }
            },
            "required": ["provider"]
          }
        },
        "required": ["llm"]
      },
      "then": {
        "properties": {
          "llm": {
            "required": ["bedrock"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": { "const": "azure-openai" }
            },
            "required": ["provider"]
          }
        },
        "required": ["llm"]
      },
      "then": {
        "properties": {
          "llm": {
            "required": ["azureOpenAI"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": { "const": "nirmataAI" }
            },
            "required": ["provider"]
          }
        },
        "required": ["llm"]
      },
      "then": {
        "properties": {
          "llm": {
            "required": ["nirmataAI"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": { "const": "anthropic" }
            },
            "required": ["provider"]
          }
        },
        "required": ["llm"]
      },
      "then": {
        "properties": {
          "llm": {
            "required": ["anthropic"],
            "properties": {
              "anthropic": {
                "required": ["model", "secretRef"],
                "properties": {
                  "model": { "minLength": 1 },
                  "secretRef": {
                    "required": ["name"],
                    "properties": {
                      "name": { "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": { "const": "nirmataAI" }
            },
            "required": ["provider"]
          }
        },
        "required": ["llm"]
      },
      "then": {
        "properties": { 
          "nirmata": { 
            "description": "Nirmata configuration for command-line flags. These values are used to set flags (--service-account-token-secret or --api-token-secret, --url) and are not part of LLMConfig. The auth field determines which credential type to use."
          } 
        }
      }
    },
    {
      "if": {
        "properties": {
          "nirmata": {
            "type": "object",
            "properties": {
              "auth": { "const": "serviceAccountToken" }
            },
            "required": ["auth"]
          }
        },
        "required": ["nirmata"]
      },
      "then": {
        "properties": {
          "nirmata": {
            "required": ["serviceAccountTokenSecret", "serviceAccountTokenSecretKey"],
            "properties": {
              "serviceAccountTokenSecret": { 
                "type": "string",
                "minLength": 1 
              },
              "serviceAccountTokenSecretKey": { 
                "type": "string",
                "minLength": 1 
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nirmata": {
            "type": "object",
            "properties": {
              "auth": { "const": "apiToken" }
            },
            "required": ["auth"]
          }
        },
        "required": ["nirmata"]
      },
      "then": {
        "properties": {
          "nirmata": {
            "required": ["apiTokenSecret", "apiTokenSecretKey"],
            "properties": {
              "apiTokenSecret": { 
                "type": "string",
                "minLength": 1 
              },
              "apiTokenSecretKey": { 
                "type": "string",
                "minLength": 1 
              }
            }
          }
        }
      }
    }
  ]
}


