{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "llm": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "bedrock",
            "azure-openai",
            "nirmataAI"
          ]
        },
        "bedrock": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "secretRef": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "azureOpenAI": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "deploymentName": {
              "type": "string"
            },
            "secretRef": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "nirmataAI": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": {
              "type": "string"
            }
          }
        }
      }
    },
    "nirmata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "auth": {
          "type": "string",
          "enum": [
            "serviceAccountToken",
            "apiToken"
          ]
        },
        "serviceAccountTokenSecret": {
          "type": "string"
        },
        "serviceAccountTokenSecretKey": {
          "type": "string"
        },
        "apiTokenSecret": {
          "type": "string"
        },
        "apiTokenSecretKey": {
          "type": "string"
        }
      },
      "required": [
        "auth"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "azure-devops"
          ],
          "description": "Git provider hosting the repositories the agent opens PRs against. Unrelated to llm.provider."
        },
        "baseURL": {
          "type": "string",
          "description": "Optional API endpoint override for self-hosted git servers (GitHub Enterprise, self-managed GitLab, Azure DevOps Server)."
        },
        "credentials": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "pat",
                "app"
              ]
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional TLS settings for reaching the git server; rendered into ToolConfig spec.tls.",
          "properties": {
            "caBundleSecretRef": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "namespace": {
                  "type": "string"
                }
              }
            },
            "insecureSkipVerify": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": {
                "const": "bedrock"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "llm"
        ]
      },
      "then": {
        "properties": {
          "llm": {
            "required": [
              "bedrock"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": {
                "const": "azure-openai"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "llm"
        ]
      },
      "then": {
        "properties": {
          "llm": {
            "required": [
              "azureOpenAI"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": {
                "const": "nirmataAI"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "llm"
        ]
      },
      "then": {
        "properties": {
          "llm": {
            "required": [
              "nirmataAI"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "llm": {
            "type": "object",
            "properties": {
              "provider": {
                "const": "nirmataAI"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "llm"
        ]
      },
      "then": {
        "properties": {
          "nirmata": {
            "description": "Nirmata configuration for command-line flags. These values are used to set flags (--service-account-token-secret or --api-token-secret, --url) and are not part of LLMConfig. The auth field determines which credential type to use."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nirmata": {
            "type": "object",
            "properties": {
              "auth": {
                "const": "serviceAccountToken"
              }
            },
            "required": [
              "auth"
            ]
          }
        },
        "required": [
          "nirmata"
        ]
      },
      "then": {
        "properties": {
          "nirmata": {
            "required": [
              "serviceAccountTokenSecret",
              "serviceAccountTokenSecretKey"
            ],
            "properties": {
              "serviceAccountTokenSecret": {
                "type": "string",
                "minLength": 1
              },
              "serviceAccountTokenSecretKey": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nirmata": {
            "type": "object",
            "properties": {
              "auth": {
                "const": "apiToken"
              }
            },
            "required": [
              "auth"
            ]
          }
        },
        "required": [
          "nirmata"
        ]
      },
      "then": {
        "properties": {
          "nirmata": {
            "required": [
              "apiTokenSecret",
              "apiTokenSecretKey"
            ],
            "properties": {
              "apiTokenSecret": {
                "type": "string",
                "minLength": 1
              },
              "apiTokenSecretKey": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "type": "object",
            "properties": {
              "type": {
                "const": "azure-devops"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "properties": {
              "credentials": {
                "properties": {
                  "method": {
                    "const": "pat",
                    "description": "azure-devops supports only PAT authentication"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
